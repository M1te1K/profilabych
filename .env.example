# Этап 2: ключ нужен только для обычного CLI. --check и --demo работают офлайн.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/profilabych.sqlite3

TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Только явный бесплатный ID; адаптер проверяет тариф и tools перед completion.
LLM_MODEL=qwen/qwen3-coder:free
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=0.5

# Раздельные ограничения раундов и общего количества вызовов.
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_TOOL_ROUNDS=5
TOOL_TIMEOUT_SECONDS=5
TOOL_RESULT_MAX_CHARS=8000
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_CHARS=64000
USER_INPUT_MAX_CHARS=4000
NOTE_MAX_LENGTH=2000
